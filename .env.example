# IP del host en la LAN. La usan el navegador para hablar con MediaMTX y
# MediaMTX para anunciar su candidato ICE. NO sirve 127.0.0.1 si vas a abrir
# el mosaico desde otra maquina.
HOST_IP=192.168.1.10

# Segmento que propone la interfaz al abrir. Se puede cambiar sin reiniciar.
SCAN_CIDR=192.168.1.0/24

# Rótulo quemado en cada celda del mosaico: nombre de la cámara (arriba-izq.)
# y fecha/hora (abajo-dcha.). Se dibuja DESPUÉS del recorte, así que se ve
# aunque la cámara sea 4:3 y el OSD del fabricante quede fuera del encuadre.
# 1 = sí (por defecto), 0 = no.
MOSAIC_LABELS=1
# Nombre de la camara arriba a la izquierda. 0 = solo la barra
# inferior con la fecha/hora (por defecto), 1 = tambien el nombre.
MOSAIC_TITLE=0
# Reloj de CamWay en cada celda del mosaico:
#   auto = solo en las camaras cuyo reloj propio se pierde al recortar
#          a 16:9 (por defecto). Las 16:9 ya traen el suyo y no se toca.
#   all  = en todas (se solaparia con el de la camara 16:9).
#   off  = ninguna.
MOSAIC_CLOCK=auto

# --- Avisos fuera de pantalla: foto de la alarma por WhatsApp (grupo) y/o correo ---
# Se activan POR CÁMARA desde la interfaz (Comportamiento IA > "Avisar con foto").
# Sin estas variables el canal queda "no configurado" y no se envía nada.
SITE_NAME=Taladro
# WhatsApp vía Evolution API (instancia dedicada: ver tools/evolution_alertas.sh)
EVO_URL=
EVO_INSTANCE=alertas
EVO_KEY=
ALERT_GROUP=
# Correo (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=starttls
ALERT_EMAILS=
