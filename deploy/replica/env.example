# CamWay · plantilla de configuración (.env)
#
# Copiar a /opt/camway/.env y ajustar. bootstrap.sh la genera sola con las
# claves aleatorias si no existe.
#
# NO subir nunca el .env real al repositorio: lleva credenciales de cámaras,
# de WhatsApp y de acceso al VPS.

# --- Identidad del equipo -------------------------------------------------
# IP REAL del equipo en la LAN (no 127.0.0.1): la usa el navegador para hablar
# con MediaMTX y MediaMTX para anunciar su candidato ICE.
HOST_IP=192.168.1.10
# Segmento que propone el buscador de cámaras al abrir la interfaz.
SCAN_CIDR=192.168.1.0/24
# Nombre del sitio (aparece en avisos y en el panel).
SITE_NAME=Mi sitio

# --- Claves ---------------------------------------------------------------
# Cifra en reposo las credenciales de cámara guardadas en SQLite. Si se pierde
# o se cambia, esas credenciales quedan ilegibles (hay que volver a meterlas).
# Generar: openssl rand -base64 32
CAMWAY_SECRET_KEY=
# Contraseña de PostgreSQL de Evolution API (avisos por WhatsApp).
# Generar: openssl rand -hex 16
EVO_DB_PASS=

# --- Grabación ------------------------------------------------------------
# Carpeta de grabaciones. Si se define, es un bind mount del host (recomendado
# con SSD dedicado). Si se deja vacía, se usa un volumen Docker.
CAMWAY_REC_DIR=/opt/camway/rec
# Grabar todas las cámaras de forma continua y cuántos días conservar.
RECORD_ALL=1
RECORD_ALL_DAYS=14

# --- Video ----------------------------------------------------------------
# Mosaico siempre en vivo (WebRTC), nunca por fotogramas.
MOSAIC_MODE=live
# Sin audio en el transcode (muchos DVR entregan pcm_mulaw con DTS erráticos).
NO_AUDIO=1
# El muro de fotogramas nunca tira directo al DVR (evita el deadlock de slots).
WALL_NO_DIRECT=1
# Fotogramas por segundo del muro (3 es buen equilibrio).
WALL_FPS=3
# Log de ffmpeg del mosaico: warning | info | verbose.
MOSAIC_LOGLEVEL=warning
# Rótulo quemado en cada celda del mosaico (nombre de la cámara + fecha/hora).
# 1 = sí (por defecto), 0 = no.
MOSAIC_LABELS=1
# Nombre de la camara arriba a la izquierda. 0 = solo la barra
# inferior con la fecha/hora (por defecto), 1 = tambien el nombre.
MOSAIC_TITLE=0
# Reloj de CamWay en cada celda del mosaico:
#   auto = solo en las camaras cuyo reloj propio se pierde al recortar
#          a 16:9 (por defecto). Las 16:9 ya traen el suyo y no se toca.
#   all  = en todas (se solaparia con el de la camara 16:9).
#   off  = ninguna.
MOSAIC_CLOCK=auto
# Fotogramas por segundo que analiza la IA (no afecta al video en vivo).
ANALYZE_FPS=2

# --- Avisos por WhatsApp (perfil "alertas") -------------------------------
# Con COMPOSE_PROFILES=alertas se levantan Evolution API y su PostgreSQL.
# Dejar COMPOSE_PROFILES vacío si no se usan avisos por WhatsApp.
# COMPOSE_PROFILES=alertas
EVO_URL=http://evolution:8080
EVO_INSTANCE=alertas
EVO_KEY=
EVO_API=v2
ALERT_GROUP=

# --- Avisos por correo (opcional) -----------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=starttls
ALERT_EMAILS=

# --- Nube / Command Center (opcional, datos del cliente) ------------------
# CAMWAY_RELAY_CC=https://rtdriller.com
# CAMWAY_RELAY_SOURCE=
# CAMWAY_RELAY_KEY=
# CAMWAY_RELAY_SRT=rtdriller.com:8890
# CAMWAY_RELAY_USER=relay
# CAMWAY_RELAY_PASS=
# CAMWAY_RELAY_PASSPHRASE=

# --- Monitor del anfitrión (opcional) -------------------------------------
# Netdata del host; el panel lo lee para el resumen de salud.
NETDATA_URL=http://host.docker.internal:19999
