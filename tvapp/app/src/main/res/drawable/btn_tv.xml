<?xml version="1.0" encoding="utf-8"?>
<!-- Botón estilo TV: cambia claramente de color al TENER FOCO (navegación con
     control remoto), para saber dónde estás parado. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2F6FED" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="#AFC8FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1E4FA8" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#17233B" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#2A3650" />
        </shape>
    </item>
</selector>
